@page
@model BankaExtreAnaliz.Pages.UploadModel
@{
    ViewData["Title"] = "Ekstre Yükle";
}

<!-- Başlık Alanı -->
<div class="mb-4">
    <h4 class="fw-bold mb-1">Ekstre Yükle</h4>
    <p class="text-secondary small mb-0">Bankalarınızın hesap hareketlerini PDF, Excel veya CSV formatında yükleyin.</p>
</div>

<!-- Sadece "Başarıyla yüklendi" mesajı -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 1. ADIM: Dosya Seçme ve Yükleme Formu -->
<form method="post" asp-page-handler="Preview" enctype="multipart/form-data">
    <div class="row g-4 mb-4">
        <!-- Sol Alan: Dosya Seçimi -->
        <div class="col-lg-8">
            <div class="app-card h-100 d-flex flex-column justify-content-center align-items-center text-center p-5" 
                 id="dropZone" 
                 style="border: 2px dashed var(--border-color); cursor: pointer; min-height: 320px;">
                
                <div class="rounded-circle p-3 mb-3 d-flex align-items-center justify-content-center" 
                     style="width: 70px; height: 70px; background-color: var(--input-bg);">
                    <i class="bi bi-cloud-arrow-up text-primary" style="font-size: 2.2rem;"></i>
                </div>

                <h6 class="fw-bold mb-1">Dosyaları sürükleyip bırakın</h6>
                <span class="text-secondary small mb-3">veya</span>

                <input type="file" id="fileInput" name="StatementFile" class="d-none" accept=".pdf,.xls,.xlsx,.csv" required />
                <button type="button" class="btn btn-primary px-4 py-2 fw-medium mb-3" onclick="document.getElementById('fileInput').click()">
                    Dosya Seç
                </button>

                <div id="selectedFileName" class="text-primary fw-medium small mb-3" style="display: none;"></div>

                <div class="d-flex align-items-center gap-3 text-secondary small">
                    <span class="d-flex align-items-center gap-1"><i class="bi bi-file-earmark-pdf text-danger"></i> PDF</span>
                    <span class="d-flex align-items-center gap-1"><i class="bi bi-file-earmark-excel text-success"></i> Excel</span>
                    <span class="d-flex align-items-center gap-1"><i class="bi bi-file-earmark-text text-info"></i> CSV</span>
                </div>
                <small class="text-secondary mt-2" style="font-size: 0.72rem;">Desteklenen formatlar: pdf, xlsx, xls, csv</small>
            </div>
        </div>

        <!-- Sağ Alan: Hesap Seçimi -->
        <div class="col-lg-4">
            <div class="app-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <h6 class="fw-bold mb-3">Hesap / Banka Seçimi</h6>
                    
                    <div class="mb-3">
                        <select name="SelectedAccountId" class="form-select form-select-sm mb-3" id="accountDropdown" required>
                            <option value="">İlgili Hesabı Seçin</option>
                            @foreach (var acc in Model.Accounts)
                            {
                                <option value="@acc.Id">@acc.BankName - @acc.AccountName</option>
                            }
                        </select>
                    </div>

                    <div class="list-group list-group-flush gap-1">
                        @foreach (var acc in Model.Accounts)
                        {
                            <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 border rounded py-2" 
                                   style="cursor: pointer; background: transparent; border-color: var(--border-color) !important;">
                                <input class="form-check-input mt-0 me-1" type="radio" name="quickAcc" value="@acc.Id" onchange="document.getElementById('accountDropdown').value=this.value">
                                <i class="bi bi-bank2 text-primary"></i>
                                <div class="d-flex flex-column">
                                    <span class="small fw-medium">@acc.BankName</span>
                                    <small class="text-secondary" style="font-size: 0.72rem;">@acc.AccountName</small>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mt-4 fw-medium">
                    <i class="bi bi-eye me-1"></i> Dosyayı İncele (Önizleme)
                </button>
            </div>
        </div>
    </div>
</form>

<!-- 2. ADIM: ÖNİZLEME TABLOSU (Dosya incelendiğinde açılır) -->
@if (Model.PreviewTransactions != null && Model.PreviewTransactions.Any())
{
    <div class="app-card mb-4 border border-primary border-opacity-50">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h6 class="fw-bold text-primary mb-1">
                    <i class="bi bi-file-earmark-check me-1"></i> Önizleme: Okunan İşlemler
                </h6>
                <small class="text-secondary">Veriler henüz kaydedilmedi. Bilgileri kontrol edip onaylayın.</small>
            </div>

            <!-- Onay Formu -->
            <form method="post" asp-page-handler="Save">
                <input type="hidden" name="SerializedPreviewData" value="@Model.SerializedPreviewData" />
                <button type="submit" class="btn btn-success px-4 py-2 fw-medium shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Onayla ve Kaydet
                </button>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small border-bottom" style="border-color: var(--border-color) !important;">
                        <th class="ps-3">Tarih</th>
                        <th>Açıklama</th>
                        <th class="text-end pe-3">Tutar</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var item in Model.PreviewTransactions)
                    {
                        <tr>
                            <td class="ps-3 text-secondary text-nowrap">@item.TransactionDate.ToString("dd.MM.yyyy")</td>
                            <td class="fw-medium">@item.Description</td>
                            <td class="text-end pe-3 fw-bold @(item.IsExpense ? "text-danger" : "text-success") text-nowrap">
                                @(item.IsExpense ? "- " : "+ ")@item.Amount.ToString("C2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const selectedFileName = document.getElementById('selectedFileName');

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                selectedFileName.style.display = 'block';
                selectedFileName.innerText = 'Seçilen Dosya: ' + fileInput.files[0].name;
            }
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.style.borderColor = '#2563eb';
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.style.borderColor = 'var(--border-color)';
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.style.borderColor = 'var(--border-color)';
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                selectedFileName.style.display = 'block';
                selectedFileName.innerText = 'Seçilen Dosya: ' + e.dataTransfer.files[0].name;
            }
        });
    </script>
}
@page
@model BankaExtreAnaliz.Pages.AccountsModel
@{
    ViewData["Title"] = "Hesaplarım";
}

<!-- Başlık Alanı -->
<div class="mb-4">
    <h4 class="fw-bold mb-1">Banka ve Hesaplarım</h4>
    <p class="text-secondary small mb-0">Tanımlı banka hesaplarınızı yönetebilir veya yeni bir hesap ekleyebilirsiniz.</p>
</div>

<div class="row g-4">
    <!-- Sol Kart: Yeni Hesap Ekleme Formu -->
    <div class="col-lg-4">
        <div class="app-card h-100">
            <h6 class="fw-bold mb-3">Yeni Hesap Ekle</h6>
            
            <form method="post" asp-page-handler="AddAccount">
                <div class="mb-3">
                    <label class="form-label small text-secondary fw-semibold">Banka Adı</label>
                    <input type="text" asp-for="BankName" class="form-control form-control-sm" placeholder="Örn: Garanti BBVA, Akbank" required />
                </div>

                <div class="mb-4">
                    <label class="form-label small text-secondary fw-semibold">Hesap Adı / Türü</label>
                    <input type="text" asp-for="AccountName" class="form-control form-control-sm" placeholder="Örn: Maaş Hesabı, Kredi Kartı" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-medium">
                    <i class="bi bi-plus-circle me-1"></i> Hesabı Kaydet
                </button>
            </form>
        </div>
    </div>

    <!-- Sağ Kart: Tanımlı Hesaplar Listesi -->
    <div class="col-lg-8">
        <div class="app-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Tanımlı Hesaplar</h6>
                <span class="badge border text-secondary" style="border-color: var(--border-color) !important;">
                    Toplam: @Model.Accounts.Count
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-secondary small border-bottom" style="border-color: var(--border-color) !important;">
                            <th>Banka</th>
                            <th>Hesap Adı</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.Accounts.Any())
                        {
                            foreach (var account in Model.Accounts)
                            {
                                <tr>
                                    <td class="fw-medium">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle p-2 text-primary d-flex align-items-center justify-content-center" 
                                                 style="width: 32px; height: 32px; background-color: var(--input-bg);">
                                                <i class="bi bi-bank2"></i>
                                            </div>
                                            <span>@account.BankName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border" style="border-color: var(--border-color) !important;">
                                            @account.AccountName
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="DeleteAccount" asp-route-id="@account.Id" 
                                              onsubmit="return confirm('Bu hesabı silmek istediğinize emin misiniz?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm text-danger p-0 border-0 bg-transparent" title="Hesabı Sil">
                                                <i class="bi bi-trash fs-6"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-secondary py-5">
                                    <i class="bi bi-credit-card fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                    Henüz kayıtlı bir banka hesabı bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
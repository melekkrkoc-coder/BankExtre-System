@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BankaAnaliz</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex @(Configuration["PUBLIC_DEMO"] == "true" ? "public-demo" : "")">
    <!-- Sol Menü -->
    <aside class="app-sidebar">
        <div>
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <div class="bg-primary text-white rounded p-1 d-flex align-items-center justify-content-center" style="width:34px; height:34px;">
                    <i class="bi bi-bar-chart-fill fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold text-white lh-1">BankaAnaliz</div>
                    <small style="font-size: 0.68rem; color: #64748b;">Finansal Özgürlüğün İçin</small>
                </div>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index">
                    <i class="bi bi-house-door"></i> Ana Sayfa
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Transactions" ? "active" : "")" asp-page="/Transactions">
                    <i class="bi bi-list-columns-reverse"></i> Hesap Hareketleri
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Upload" ? "active" : "")" asp-page="/Upload">
                    <i class="bi bi-cloud-arrow-up"></i> Ekstre Yükle
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Accounts" ? "active" : "")" asp-page="/Accounts">
                    <i class="bi bi-wallet2"></i> Hesaplarım
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Categories" ? "active" : "")" asp-page="/Categories">
                    <i class="bi bi-grid"></i> Kategori & Kurallar
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Reports" ? "active" : "")" asp-page="/Reports">
                    <i class="bi bi-graph-up-arrow"></i> Raporlar
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Settings" ? "active" : "")" asp-page="/Settings">
                    <i class="bi bi-gear"></i> Ayarlar
                </a>
            </nav>
        </div>

        <!-- Offline Mod Rozeti -->
        <div class="p-2 rounded bg-opacity-10 bg-secondary border border-secondary border-opacity-25" style="font-size: 0.75rem;">
            <div class="fw-bold text-white d-flex align-items-center gap-1">
                <i class="bi bi-shield-check text-success"></i> Offline Mod
            </div>
            <div class="text-secondary" style="font-size: 0.68rem;">Tüm verileriniz yerel olarak bilgisayarınızda saklanır.</div>
        </div>
    </aside>

    <!-- Sağ Ana Alan -->
    <div class="flex-grow-1 d-flex flex-column min-vh-100">
        <!-- Üst Bar -->
        <header class="app-topbar">
            <!-- Aktif Arama Çubuğu -->
            <form action="/Transactions" method="get" class="topbar-search m-0" id="globalSearchForm">
                <button type="submit" class="btn p-0 border-0 bg-transparent text-secondary d-flex align-items-center">
                    <i class="bi bi-search"></i>
                </button>
                <input type="text" name="searchTerm" id="globalSearchInput" placeholder="İşlem, kurum veya açıklama ara (Enter)..." />
            </form>

            <!-- Sağ Araçlar: Tema, Tarih, Bildirim, Profil -->
            <div class="d-flex align-items-center gap-3">
                <!-- Açık / Koyu Tema Butonu -->
                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="themeToggleBtn">
                    <i class="bi bi-moon-stars" id="themeIcon"></i>
                    <span id="themeText" style="font-size: 0.8rem;">Koyu</span>
                </button>

                <!-- Bildirim İkonu -->
                <button type="button" class="btn btn-sm position-relative text-secondary p-1 border-0">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>

                <!-- Profil -->
                <div class="d-flex align-items-center gap-2 border-start ps-3">
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:32px; height:32px; font-size: 0.85rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <span class="fw-medium small">Kullanıcı</span>
                </div>
            </div>
        </header>

        <!-- Dinamik Sayfa İçeriği -->
        <main class="p-4 flex-grow-1">
            @if (Configuration["PUBLIC_DEMO"] == "true")
            {
                <div class="alert alert-info border-0 shadow-sm" role="note">
                    <i class="bi bi-info-circle-fill me-2"></i>Herkese açık demo: yalnızca örnek veriler kullanılır. Ekstre yükleme ve veri değişiklikleri kapalıdır.
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tema Geçişi
        const themeBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');
        const themeText = document.getElementById('themeText');
        const htmlElement = document.documentElement;

        const currentTheme = localStorage.getItem('app-theme') || 'light';
        setTheme(currentTheme);

        themeBtn.addEventListener('click', () => {
            const nextTheme = htmlElement.getAttribute('data-bs-theme') === 'light' ? 'dark' : 'light';
            setTheme(nextTheme);
            localStorage.setItem('app-theme', nextTheme);
        });

        function setTheme(theme) {
            htmlElement.setAttribute('data-bs-theme', theme);
            if (theme === 'dark') {
                themeIcon.className = 'bi bi-sun';
                themeText.textContent = 'Açık';
            } else {
                themeIcon.className = 'bi bi-moon-stars';
                themeText.textContent = 'Koyu';
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>